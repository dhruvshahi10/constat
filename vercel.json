{
  "version": 2,
  "builds": [
    {
      "src": "api/{ask,waitlist}.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "{trustops/**,data/evidence/**,api/**}" }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    { "src": "/api/ask", "dest": "/api/ask.py" },
    { "src": "/api/waitlist", "dest": "/api/waitlist.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/([a-z0-9-]+)/?$", "dest": "/public/$1/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
