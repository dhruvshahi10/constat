# Constat API. Copy to .env; never commit .env.
CONSTAT_ENV=dev                       # dev enables CONSTAT_DEV_TOKEN and HS256 dev JWTs; anything else disables both
CONSTAT_TENANT=constat                # default tenant slug for JWT principals without a tenant claim
DATABASE_URL=sqlite:///data/sidecar.db   # or postgresql://user:pass@host:5432/db (Supabase)
CLAIM_STORE=file                      # file | atlan
CLAIM_STORE_PATH=data/claims          # file store root, or the Atlan store's local sidecar
ATLAN_GLOSSARY=Security Claims        # glossary that holds the claim terms (CLAIM_STORE=atlan)
ATLAN_BASE_URL=                       # pyatlan: https://<tenant>.atlan.com
ATLAN_API_KEY=                        # pyatlan API token
ATLAN_JWKS_URL=                       # embedded-app JWT verification (RS256)
ATLAN_JWT_PUBLIC_KEY=                 # or a pinned PEM public key
ATLAN_ISSUER=                         # expected iss, if known
CONSTAT_ATLAN_AUDIENCE=constat        # expected aud
CONSTAT_DEV_TOKEN=                    # dev only: bearer that grants admin
CONSTAT_DEV_JWT_SECRET=               # dev only: HS256 secret for the shell simulator, at least 32 bytes
CONSTAT_CORS_ORIGINS=http://localhost:3000
ANTHROPIC_API_KEY=                    # Haiku 4.5 normaliser and drafter
CONSTAT_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=                       # synthetic demos only
VANTA_TOKEN=
SLACK_WEBHOOK_URL=
